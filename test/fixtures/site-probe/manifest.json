{
  "manifest_version": 2,
  "name": "VivaldiFox test: site probe",
  "version": "1.0",
  "browser_specific_settings": { "gecko": { "id": "vfx-site-probe@test" } },
  "permissions": ["webRequest", "webRequestBlocking", "declarativeNetRequest", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "all_frames": true, "run_at": "document_start" }],
  "declarative_net_request": { "rule_resources": [{ "id": "probe", "enabled": true, "path": "rules.json" }] }
}
